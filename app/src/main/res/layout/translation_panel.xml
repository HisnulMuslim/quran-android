<?xml version="1.0" encoding="utf-8"?>
<!--KQACR26-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
             android:orientation="vertical"
             android:layout_width="match_parent"
             android:layout_height="match_parent"
             android:background="@color/page_background"
    >
  <!-- TODO: check theme android:theme="@style/Quran" -->
  <!--KQACR26 added android:textColor for linearlayout and removed for QuranSpinner-->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:orientation="vertical"
      android:textColor="@color/accent_color"
      >
    <com.quran.labs.androidquran.view.QuranSpinner
        android:id="@+id/translator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:layout_marginLeft="@dimen/translation_left_right_margin"
        android:layout_marginRight="@dimen/translation_left_right_margin"
        android:backgroundTint="@color/title_color"
        android:textSize="14sp"
        android:textStyle="bold"
        />
    <HorizontalScrollView
        android:id="@+id/compare_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:visibility="gone"
        android:paddingLeft="@dimen/translation_left_right_margin"
        android:paddingRight="@dimen/translation_left_right_margin"
        android:paddingTop="4dp"
        android:paddingBottom="10dp"
        >
      <LinearLayout
          android:id="@+id/compare_bar"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          />
    </HorizontalScrollView>
    <View
        android:id="@+id/translation_header_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/continue_reading_card_stroke"
        />
    <com.quran.labs.androidquran.view.InlineTranslationView
        android:id="@+id/translation_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        />
  </LinearLayout>

  <com.quran.labs.androidquran.view.LeftToRightLinearLayout
      android:id="@+id/controls"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_gravity="bottom"
      android:paddingStart="12dp"
      android:paddingEnd="12dp"
      android:paddingBottom="10dp"
      >
    <ImageButton
        android:id="@+id/next_ayah"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/translation_nav_button_bg"
        android:src="@drawable/ic_translation_next"
        android:tint="@color/title_color"
        android:contentDescription="@string/next"
        android:scaleType="centerInside"
        android:padding="10dp"
        />
    <Space
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        />
    <ImageButton
        android:id="@+id/previous_ayah"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/translation_nav_button_bg"
        android:src="@drawable/ic_translation_previous"
        android:tint="@color/title_color"
        android:contentDescription="@string/previous"
        android:scaleType="centerInside"
        android:padding="10dp"
        />
  </com.quran.labs.androidquran.view.LeftToRightLinearLayout>

  <LinearLayout
      android:id="@+id/empty_state"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:padding="16dp"
      android:orientation="vertical"
      android:visibility="gone"
      >
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="10dp"
        android:gravity="center_horizontal"
        android:textColor="@color/title_color"
        android:text="@string/need_translation"
        />
    <Button
        android:id="@+id/get_translations_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/accent_color_dark"
        android:textColor="@color/toolbar_text"
        android:text="@string/get_translations"
        />
  </LinearLayout>

  <ProgressBar
      android:id="@+id/progress"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center"
      />
</FrameLayout>
