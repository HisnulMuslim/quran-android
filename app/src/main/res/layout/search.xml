<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/page_background"
        android:id="@+id/root">
    <TextView android:id="@+id/search_warning"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:background="@color/continue_reading_card_bg"
              android:paddingStart="16dp"
              android:paddingEnd="16dp"
              android:paddingTop="10dp"
              android:paddingBottom="10dp"
              android:textSize="14sp"
              android:visibility="gone"
              android:textColor="@color/title_color" />
    <Button android:id="@+id/btnGetTranslations"
            android:text="@string/menu_get_translations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="4dp"
            android:backgroundTint="@color/accent_color"
            android:textColor="@color/toolbar_text"
            android:visibility="gone"/>

  <TextView
      android:id="@+id/search_area"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@color/secondary_dark_background"
      android:paddingStart="16dp"
      android:paddingEnd="16dp"
      android:paddingTop="10dp"
      android:paddingBottom="10dp"
      android:text="@string/search_key"
      android:textColor="@color/title_color"
      android:fontFamily="sans-serif-medium"
      android:textSize="15sp" />

  <View
      android:layout_width="match_parent"
      android:layout_height="1dp"
      android:background="@color/continue_reading_card_stroke" />

    <ListView
            android:id="@+id/results_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/page_background"
            android:divider="@color/continue_reading_card_stroke"
            android:dividerHeight="1dp" />
</LinearLayout>
